OPENAI_API_KEY=
PORT=3000
NODE_ENV=development

# JWT signing (required when NODE_ENV=production)
JWT_SECRET=change_this_to_a_long_random_string

# Optional — set true to require Bearer token on all /api/dashboard/* routes
REQUIRE_AUTH=false

# Public URL for invitation / recap emails
APP_BASE_URL=http://localhost:3000

# Rate limits (requests / 15 minutes per IP)
RATE_LIMIT_MAX=900
AUTH_RATE_LIMIT_MAX=60

# Optional — Google (same OAuth "Web application" client for Sign-In + Calendar)
# Authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Optional — Slack Incoming Webhook when "Slack digest" is enabled (or set in Settings UI)
SLACK_WEBHOOK_URL=

# Optional — email (invites, recap on coach complete, meeting prep on schedule)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RECAP_EMAIL_TO=

# Optional — observability (install @sentry/node and initialize in server if you use this)
# SENTRY_DSN=
